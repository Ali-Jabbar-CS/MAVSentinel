{
    "name": "MAVSentinel Dev",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "ubuntu",
    "runArgs": [
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "ms-python.python"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "files.eol": "\n",
                "files.insertFinalNewline": true,
                "files.trimTrailingWhitespace": true
            }
        }
    }
}
